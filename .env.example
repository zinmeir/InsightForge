# Copy to .env and adjust. docker compose reads it automatically.
# Every value below has a development default in docker-compose.yml; the ones marked
# REQUIRED IN PRODUCTION must be changed before exposing InsightForge to anyone.

# --- runtime -----------------------------------------------------------------
# "production" makes the backend refuse to start with insecure defaults.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- elasticsearch -------------------------------------------------------------
ES_VERSION=8.17.0
ES_HEAP=1g
ELASTIC_PASSWORD=insightforge-dev            # REQUIRED IN PRODUCTION
LOG_RETENTION_DAYS=14

# --- auth ------------------------------------------------------------------------
AUTH_ENABLED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me   # REQUIRED IN PRODUCTION
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin                          # REQUIRED IN PRODUCTION
# Optional read-only account
VIEWER_USERNAME=
VIEWER_PASSWORD=
# Comma-separated keys accepted in the X-API-Key header by the ingestion endpoints.
INGEST_API_KEYS=dev-ingest-key                # REQUIRED IN PRODUCTION
# Only needed if the UI is served from a different origin than the API.
CORS_ORIGINS=

# --- notifications (leave blank to disable a channel) ------------------------------
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
ALERT_WEBHOOK_URL=
# If set, webhook requests carry X-InsightForge-Signature: sha256=<hmac of body>
ALERT_WEBHOOK_SECRET=
PUBLIC_DASHBOARD_URL=http://localhost:3000

# --- demo traffic (docker compose --profile demo up) ----------------------------------
LOADGEN_API_KEY=dev-ingest-key
LOADGEN_RATE=25
